{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // Unit tests run on Node (`npm run test:jelines` from the repo root) and pull
  // in node: builtins the browser build has no types for. They are typechecked
  // by tsx at run time, not by the app build.
  "exclude": ["src/**/__tests__/**"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
