# syntax=docker/dockerfile:1
FROM node:20-alpine AS build

WORKDIR /app

# Install client dependencies. @kisaesdevlab/vibe-auth (the LoginPanel and
# Settings → Authentication components) comes from GitHub Packages, which needs
# a token even for reads; see Dockerfile.server for the secret mechanism.
COPY client/package.json client/package-lock.json* client/.npmrc client/
RUN --mount=type=secret,id=NODE_AUTH_TOKEN,required=true \
    printf '//npm.pkg.github.com/:_authToken=%s\n' "$(cat /run/secrets/NODE_AUTH_TOKEN)" > /root/.npmrc \
 && cd client && npm ci \
 && rm -f /root/.npmrc

# Copy client source and build
COPY client/ client/
RUN cd client && npm run build

# Serve with Nginx. nginx:alpine runs the master as root (required to bind :80)
# but worker processes already drop to the unprivileged `nginx` user per the
# default config. The entrypoint substitutes the build-time VITE_BASE_PATH
# sentinel so the same image serves either '/' or a multi-app subpath.
FROM nginx:alpine
COPY --from=build /app/client/dist /usr/share/nginx/html
COPY deploy/nginx-docker.conf /etc/nginx/conf.d/default.conf
COPY deploy/web-entrypoint.sh /docker-entrypoint.d/40-vibe-base-path.sh
RUN chmod +x /docker-entrypoint.d/40-vibe-base-path.sh
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
EXPOSE 80
