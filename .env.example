# Vibe Trial Balance — production environment template
#
# Copy to `.env` next to your docker-compose file and fill in every value.
# All of the "required" vars below must be set — compose refuses to start
# without them and the server refuses to boot without them.
#
#   cp .env.example .env
#   docker compose -f docker-compose.prod.yml up -d
#
# Single-app vs multi-app:
# - Single-app (one Vibe product per host): leave VITE_BASE_PATH unset.
# - Multi-app (Vibe TB sharing a host with other Vibe products behind a
#   shared Caddy ingress): set VITE_BASE_PATH=/tb/, set VIBE_HOST, and add
#   `-f docker-compose.grouped.yml` to the docker compose command.

# ── Required secrets ─────────────────────────────────────────────────────────

# Postgres connection — use ONE of the two forms below.
#
# (A) DATABASE_URL (preferred, single connection string). Takes precedence
#     over the discrete DB_* vars when set. Format:
#       postgres://<user>:<password>@<host>:<port>/<database>
#     The DB_PASSWORD var below is still required because docker-compose
#     uses it to initialize the postgres container.
# DATABASE_URL=postgres://vibetb:CHANGEME@db:5432/vibe_tb_db

# (B) PostgreSQL password for the `vibetb` user (discrete-vars form).
#     Required for docker-compose.prod.yml whether you use DATABASE_URL or not
#     (the bundled postgres container reads this to initialize itself).
# Generate: openssl rand -hex 24
DB_PASSWORD=

# JWT signing secret. 64+ random chars.
# Generate: openssl rand -hex 32
JWT_SECRET=

# Encryption key for stored API keys. Must be DIFFERENT from JWT_SECRET.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Browser origin the server will accept (CORS). Set to your actual host.
# Examples: http://192.168.1.50   https://tb.yourfirm.com
# In multi-app mode this is replaced by docker-compose.grouped.yml from
# VIBE_HOST, so leaving it blank in that case is fine.
ALLOWED_ORIGIN=

# ── Optional ─────────────────────────────────────────────────────────────────

# Which image tag to pull. Default is `latest` (follows main).
# Pin to a release (e.g. v1.2.3) or a specific commit (e.g. sha-a020558) in prod.
# IMAGE_TAG=latest

# JWT session lifetime. Default 8h.
# JWT_EXPIRY=8h

# Base URL used in MCP self-referencing links. Defaults to ALLOWED_ORIGIN.
# APP_BASE_URL=https://tb.yourfirm.com

# Anthropic API key for Claude-backed AI features. Optional — can also be set
# inside the app under Admin > Settings > AI Provider.
# ANTHROPIC_API_KEY=sk-ant-...

# First-boot admin login is always `admin` / `admin1234`. The app forces a
# password change on first login before anything else is reachable.

# ── Self-service password reset (optional) ──────────────────────────────────
#
# When MAIL_TRANSPORT is set, the login page shows a "Forgot password?" link
# that emails a one-time reset URL valid for 30 minutes. When unset, the link
# is hidden and the endpoint silently no-ops (admins can still reset
# passwords manually under Admin > Users).
#
# Reset URLs are built from APP_BASE_URL (preferred) or the first
# ALLOWED_ORIGIN entry. Set APP_BASE_URL when ALLOWED_ORIGIN is a regex/list.

# MAIL_TRANSPORT=                  # smtp | postmark | emailit
# MAIL_FROM=Vibe TB <noreply@yourfirm.com>

# SMTP transport
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false                # true for port 465 (TLS-on-connect)

# Postmark transport
# POSTMARK_TOKEN=

# Emailit v2 transport
# EMAILIT_API_KEY=
# EMAILIT_API_URL=https://api.emailit.com/v1


# When 'true', outbound AI/OCR URLs may not resolve to RFC1918 / loopback /
# link-local addresses. Keep unset for self-hosted Pi deployments where OCR /
# LLM runs on localhost or the LAN. Set to 'true' when deploying to a cloud
# VM to prevent SSRF into the metadata service.
# STRICT_AI_URL_SAFETY=false

# Cap the Node process heap (MB). Default 1024 on Pi-sized hosts.
# NODE_OPTIONS=--max-old-space-size=1024

# ── Distribution / multi-app ────────────────────────────────────────────────

# Sub-path the SPA is served from. '/' for single-app (default). '/tb/' when
# behind the shared Caddy ingress. Must end with a slash. Same image works
# in both modes — the web container substitutes this at startup.
# VITE_BASE_PATH=/

# Host port the web container publishes. Default 80. Set to a free port
# (e.g. 8080) when running alongside something else on :80, or unset
# entirely under multi-app mode (Caddy reaches the container internally).
# WEB_PUBLISH_PORT=80

# FQDN the multi-app Caddy ingress fronts. Required when using the grouped
# overlay; ignored otherwise. Drives ALLOWED_ORIGIN and APP_BASE_URL.
# VIBE_HOST=vibe.local

# Postgres host port for the dev compose (`docker-compose.yml`). Default
# 5432 to keep `npm run dev` working out of the box. Override to 5436
# (or any free port) if you want multiple Vibe products' DBs published
# side-by-side on the same dev host.
# POSTGRES_PUBLISH_PORT=5432

# pgAdmin host port (only used by `docker-compose.yml --profile tools`).
# Default 5051 — Vibe MyBooks already takes 5050 in multi-app deployments.
# PGADMIN_PUBLISH_PORT=5051

# GLM-OCR appliance image tag (only used by `docker-compose.prod.yml
# --profile ai`). The image is published from a separate KisaesDevLab repo.
# OCR_IMAGE_TAG=latest

# Skip auto-migration on container start. Default 'true' (entrypoint runs
# `knex migrate:latest`). Set to 'false' for appliance / orchestrated deploys
# that run `node dist/migrate.js` as a one-shot before bringing the service
# up. With MIGRATIONS_AUTO=false, the server itself refuses to start with
# pending migrations — so a misconfigured deploy fails loudly.
# MIGRATIONS_AUTO=true

# ── Document storage (optional) ──────────────────────────────────────────────
# Settings -> Document Storage overrides all of these, and is the supported way
# to configure them. These are a fallback for headless/first-boot setups.
#
# STORAGE_PROVIDER=local          # local | b2
# STORAGE_PREFIX=vibe-tb          # lets one bucket host several Vibe products
#
# B2 must be the S3-COMPATIBLE endpoint, not the native B2 API URL:
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_BUCKET=
# B2_KEY_ID=
# B2_APPLICATION_KEY=
#
# Set the bucket's lifecycle rule to "Keep only the last version", or every
# overwrite silently accumulates billable hidden versions.
