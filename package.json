{
  "name": "vibe-tb",
  "version": "0.1.50",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "migrate": "cd server && npx knex migrate:latest --knexfile knexfile.js",
    "seed": "cd server && npx knex seed:run --knexfile knexfile.js",
    "test:jelines": "cd server && npx tsx --test ../client/src/utils/__tests__/jeLines.test.ts",
    "test:reporturls": "cd server && npx tsx --test ../client/src/utils/__tests__/reportUrls.test.ts",
    "test:reportfilename": "cd server && npx tsx --test ../client/src/utils/__tests__/reportFilename.test.ts",
    "test:loginflow": "cd server && npx tsx --test ../client/src/utils/__tests__/loginFlow.test.ts",
    "test:totpcode": "cd server && npx tsx --test ../client/src/utils/__tests__/totpCode.test.ts",
    "test:webauthn": "cd server && npx tsx --test ../client/src/utils/__tests__/webauthn.test.ts",
    "test:autherrors": "cd server && npx tsx --test ../client/src/utils/__tests__/authErrors.test.ts",
    "test:twofactor-client": "cd server && npx tsx --test ../client/src/utils/__tests__/loginFlow.test.ts ../client/src/utils/__tests__/totpCode.test.ts ../client/src/utils/__tests__/webauthn.test.ts ../client/src/utils/__tests__/authErrors.test.ts ../client/src/utils/__tests__/twoFactorSummary.test.ts",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:reset": "cd server && npx knex migrate:rollback --all --knexfile knexfile.js && npx knex migrate:latest --knexfile knexfile.js && npx knex seed:run --knexfile knexfile.js",
    "test:sso-e2e": "node test/sso-e2e.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^8.2.2"
  }
}
